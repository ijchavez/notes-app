<div
  class="card mx-auto"
  style="max-width: 90%; max-height: 90vh; overflow-y: auto;"
>
  <div class="card-header">
    Account Register
  </div>
  <img src="/images/notes_reg.jpeg" class="logo d-block mx-auto" alt="notes" />
  <div class="card-body">
    <form action="/users/signup" method="POST">
      <div class="form-group">
        <input
          id="name"
          type="text"
          class="form-control"
          name="name"
          placeholder="Name"
        />
      </div>
      <div class="form-group">
        <input
          id="email"
          type="email"
          class="form-control"
          name="email"
          placeholder="Email"
        />
      </div>
      <div class="form-group">
        <input
          id="password"
          type="password"
          class="form-control"
          name="password"
          placeholder="Password"
        />
      </div>
      <div class="form-group">
        <input
          id="confirm_password"
          type="password"
          class="form-control"
          name="confirm_password"
          placeholder="Confirm Password"
        />
      </div>
      <button id="signup" class="btn btn-primary btn-block">
        Sign Up
      </button>
    </form>
  </div>
</div>